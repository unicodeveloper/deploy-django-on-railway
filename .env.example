# Copy to .env for local development. Railway reads these from service Variables.

# Comma-separated bare hostnames -- no scheme, no port. Defaults to * when unset.
ALLOWED_HOSTS=*

# Comma-separated origins allowed to send POST/PUT/PATCH/DELETE.
# Scheme is required, and the port too if it is non-standard.
# On Railway, set this in the dashboard to: https://${{RAILWAY_PUBLIC_DOMAIN}}
CSRF_TRUSTED_ORIGINS=

# Celery broker and result backend. Railway's Redis service provides REDIS_URL.
REDIS_URL=redis://localhost:6379/0

# Postgres. Railway's Postgres service provides these.
PGDATABASE=liftoff
PGUSER=
PGPASSWORD=
PGHOST=localhost
PGPORT=5432
